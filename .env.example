# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE (Required for Vercel deployment with persistent Postgres + Storage)
# Find these in your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
# Use your Supabase Secret key (sb_secret_...) or legacy Service Role key
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# Optional: Secret key used to sign participant & admin auth tokens across serverless instances.
# Recommended on Vercel; if omitted, derived securely from SUPABASE_SECRET_KEY.
AUTH_SIGNING_SECRET="replace-with-random-64-char-hex-string"
